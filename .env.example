# ── Application ──
APP_NAME=JARVIS AI System
# Set DEBUG=false in production — enables uvicorn auto-reload in dev only
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── CORS ──
# Comma-separated list of allowed frontend origins. Set to your Vercel URL in production.
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app
# Leave as * for local development only
ALLOWED_ORIGINS=*

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1000

# Input limits
MAX_INPUT_LENGTH=4000
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RESULTS=7

# ── Database ──
# Local development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///jarvis.db
# Production (PostgreSQL) — use Railway/Render free Postgres
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/jarvis

# ── Groq LLM ──
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_DEPLOYMENT=llama3-70b-8192

# ── Cohere Embeddings ──
COHERE_API_KEY=your-cohere-api-key
COHERE_EMBEDDING_MODEL=embed-english-v3.0
COHERE_EMBEDDING_DIMENSIONS=1024

# ── Azure Speech (voice input / output) ──
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus
AZURE_TTS_VOICE=en-US-AndrewNeural
AZURE_TTS_STYLE=chat
AZURE_TTS_FORCE_MALE=true

# ── WhatsApp via Whapi ──
WHAPI_TOKEN=your-whapi-token
WHAPI_BASE_URL=https://gate.whapi.cloud/messages/text
WHAPI_DEFAULT_COUNTRY_CODE=91
WHAPI_TIMEOUT_SECONDS=30
WHAPI_MAX_RETRIES=2

# ── SMS via Twilio ──
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_DEFAULT_COUNTRY_CODE=91
TWILIO_SIMULATE=false
